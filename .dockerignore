# Rzeczy, które są budowane w obrazie albo do niego nie należą.
# Bez tego kontekst builda ma setki MB i każdy deploy trwa minuty dłużej.

.git
.github
.railway
.cursor
.claude

vendor
node_modules
public/build
public/hot
public/storage

storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
!storage/**/.gitignore

.env
.env.*
!.env.example

tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache

docs
database/reference

*.md
!README.md

.editorconfig
.gitattributes
.gitignore
.dockerignore
