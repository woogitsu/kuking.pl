# ==========================================================================
# Kuking.pl — przykładowa konfiguracja środowiska
# Skopiuj do .env i uzupełnij. NIGDY nie commituj pliku .env.
# ==========================================================================

APP_NAME=Kuking
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL
APP_TIMEZONE=Europe/Warsaw

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Baza danych — PostgreSQL (produkcja: PostgreSQL 18 na Railway)
# --------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kuking
DB_USERNAME=kuking
DB_PASSWORD=kuking
# Railway wstrzykuje DATABASE_URL — Laravel odczyta je przez DB_URL.
# DB_URL=

# --------------------------------------------------------------------------
# Sesje, cache, kolejka
# MVP celowo nie używa Redisa — dopiero po zmierzonej potrzebie.
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --------------------------------------------------------------------------
# Zaufanie do nagłówków od proxy (config/proxy.php, ustalenie SEC-01)
# --------------------------------------------------------------------------
# Ile wpisów w `X-Forwarded-For` dopisuje TWOJA infrastruktura. Aplikacja
# czyta adres klienta jako n-ty wpis OD KOŃCA łańcucha — proxy dopisuje na
# końcu, klient może dopisywać tylko na początku, więc tylko liczenie od
# prawej jest odporne na podstawienie.
#
#   0  — nie ufaj temu nagłówkowi wcale (dev bez proxy, `php artisan serve`);
#   1  — jedno proxy przed aplikacją (np. samo Cloudflare). WARTOŚĆ DOMYŚLNA;
#   2  — dwa (np. Cloudflare + brzeg platformy, JEŚLI ten drugi dopisuje wpis).
#
# Zmierz, zanim zmienisz: wejdź przez swoje proxy BEZ własnego nagłówka
# `X-Forwarded-For` i policz, ile wpisów dotarło do aplikacji. Za mała
# wartość jest niegroźna (wspólny adres → zbyt ostre limity); za duża
# przywraca podatność, bo odczyt wchodzi w obszar wypełniany przez klienta.
KUKING_ZAUFANE_PRZESKOKI=0

# --------------------------------------------------------------------------
# Pliki i zdjęcia
# local — dysk lokalny (dev). r2 — Cloudflare R2 (staging/produkcja).
# --------------------------------------------------------------------------
FILESYSTEM_DISK=local
# Pusty = podąża za FILESYSTEM_DISK. Ustaw tylko, gdy zdjęcia mają leżeć
# gdzie indziej niż reszta plików.
KUKING_MEDIA_DISK=public

# Cloudflare R2 (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Bucket WARIANTÓW (przetworzone pliki WebP). Nazwa zmiennej mówi „PUBLIC",
# ale od W7-02 ten bucket NIE MA już własnej domeny: adresem zdjęcia jest
# trasa aplikacji /zdjecia/{id}/{wariant}, która pyta Policy treści nadrzędnej
# i przekierowuje na adres podpisany na kilka minut. Brak EXIF-u nie znaczy
# „wolno pokazać każdemu" — wariant przepisu prywatnego jest prywatny.
# AWS_BUCKET wyżej trzyma ORYGINAŁY i tym bardziej nie może mieć ani własnej
# domeny, ani włączonego r2.dev: leży w nich pełny EXIF z GPS-em.
# Na R2 publiczność jest cechą bucketu, nie obiektu (audyt G-01).
AWS_PUBLIC_BUCKET=
# Bucket na paczki z danymi (RODO). Prywatny, bez własnej domeny — to kopia
# całego konta. Osobny od oryginałów, bo ma inny cykl życia (TTL 7 dni).
AWS_EXPORTS_BUCKET=
# Stary, jeden bucket sprzed rozdzielenia oryginałów i wariantów. Wypełnij
# TYLKO wtedy, gdy w tym środowisku są już zdjęcia zapisane przed zmianą —
# ich pliki nadal tam leżą, dopóki `kuking:przenies-zdjecia` ich nie przeniesie.
AWS_LEGACY_BUCKET=
# Własna domena STAREGO bucketu. Po W7-02 to jedyny adres zdjęć, który jeszcze
# jest publiczny — i jedyny, który `PurgePublicMediaCache` ma co czyścić.
AWS_LEGACY_URL=
AWS_ENDPOINT=
# UWAGA: to NIE jest już adres zdjęć. Dysk `r2_publiczne` świadomie nie ma
# klucza `url` (W7-02), więc ta zmienna zasila wyłącznie zapasowy dysk `s3`
# i historyczne środowiska ze starym, jednym bucketem. Wdrożenie na Railway
# jej nie ustawia.
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# Poczta transakcyjna
#
# Co serwis wysyła mailem: potwierdzenie adresu przy rejestracji, link do
# ustawienia nowego hasła, „Twoje dane są gotowe" oraz cztery listy
# moderacyjne do zgłaszających (DSA). Tygodniowego digestu NIE MA jeszcze
# w kodzie — mimo że `docs/decyzje/POCZTA.md` liczy na nim wolumen.
#
# UWAGA — `log` NIE WYSYŁA NIC.
# Zapisuje wiadomość do `storage/logs` i zwraca sukces: rejestracja kończy
# się zieloną stroną, zadanie w kolejce kończy się bez błędu, a do nikogo
# nic nie dociera. Dla lokalnego rozwoju to jest w porządku. NA PRODUKCJI
# NIE — pierwsza osoba, która zapomni hasła, straci konto bezpowrotnie.
# Serwis o tym wie: przy `log` ekran „Nie pamiętam hasła" świadomie nie
# przyjmuje adresu i odsyła do skrzynki kontaktowej (`App\Support\Poczta`).
#
# Sterowniki, które NAPRAWDĘ wysyłają: `emaillabs`, `smtp`, `postmark`,
# `resend`, `ses`.
#
# NA PRODUKCJI JEST `emaillabs` I NIE JEST TO KWESTIA GUSTU.
# Railway wyłącza ruch SMTP na planach Free, Trial i Hobby, a właściciel jest
# na Free i przechodzi na Hobby. Na tych planach `smtp` nie kończy się błędem,
# tylko WISI: zadanie w kolejce wchodzi w `RUNNING` i nigdy nie osiąga ani
# `DONE`, ani `FAIL`. Patrz docs/DECISIONS.md D-047.
#
# Instrukcja krok po kroku (zmienne, DNS, weryfikacja): docs/infra/POCZTA_URUCHOMIENIE.md
# Sprawdzenie, że poczta wychodzi:  php artisan kuking:sprawdz-poczte ty@wp.pl
# --------------------------------------------------------------------------
MAIL_MAILER=log

# Sterownik `emaillabs` — wysyłka przez API HTTPS (bez SMTP, bez paczek).
#
# DWA KLUCZE, NIE JEDEN: żądanie niesie nagłówek `Application-Key` (pierwsza
# zmienna) i `Authorization` (druga, 128 znaków). Oba generuje się razem
# w panelu EmailLabs: Konto → Ustawienia → API → „Generuj klucz API".
# TO NIE SĄ LOGIN I HASŁO SMTP — API ich nie przyjmie i odpowie 401.
EMAILLABS_APP_KEY=
EMAILLABS_SECRET_KEY=
# Konto wysyłkowe w kształcie `1.nazwa.smtp` — pole `smtpAccount` w każdym
# żądaniu API. Znajdziesz je w panelu przy koncie SMTP.
EMAILLABS_SMTP_ACCOUNT=
# Adres API. Zmieniaj tylko wtedy, gdy dostawca ogłosi nowy — musi być HTTPS.
# EMAILLABS_ENDPOINT=https://api.emaillabs.io/v2.1/email
# Śledzenie odnośników. WYŁĄCZONE domyślnie: włączone podmienia każdy link
# w liście na adres przekierowujący dostawcy, a link do zmiany hasła
# prowadzący pod obcą domenę wygląda dla osoby 60+ jak phishing.
# EMAILLABS_TRACKING=false

# Poniższe dotyczą WYŁĄCZNIE sterownika `smtp`, który na dzisiejszym planie
# Railway NIE DZIAŁA (patrz wyżej) — zostają na wypadek planu Pro i dla
# Mailpita na własnej maszynie. Wartości niżej to zaślepki, nie serwer
# żadnego dostawcy: przy `MAIL_MAILER=smtp` każda wysyłka padnie na
# „connection refused".
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Symfony przyjmuje TYLKO `smtp` i `smtps`. `smtp` dla portu 587 (STARTTLS
# negocjuje się samo), `smtps` dla portu 465. Wartość `tls` wygląda sensownie
# i NIE DZIAŁA — transport się nie buduje, a każdy list kończy się `FAIL`.
MAIL_SCHEME=null

# Sterownik `postmark` — klucz z panelu (Server API Token).
POSTMARK_API_KEY=
# Sterownik `resend` — klucz z panelu.
RESEND_API_KEY=
# Sterownik `ses` — WŁASNE zmienne, nie `AWS_*`.
# `AWS_ACCESS_KEY_ID` i `AWS_DEFAULT_REGION` wyżej należą do Cloudflare R2
# (zdjęcia) i mają region `auto`, którego Amazon nie zna. Patrz komentarz
# przy kluczu `ses` w `config/services.php`.
MAIL_SES_KEY=
MAIL_SES_SECRET=
MAIL_SES_REGION=eu-central-1

# Adres nadawcy MUSI być skrzynką, którą ktoś czyta — żadnego `noreply@`
# (docs/brand/BRAND_EXTENDED.md). To ten sam adres co KUKING_CONTACT_EMAIL:
# pokazujemy ludziom i wysyłamy z jednego, żeby dało się odpisać.
MAIL_FROM_ADDRESS="kontakt@kuking.pl"
# NIEUSTAWIONE CELOWO: nazwa nadawcy domyślnie składa się z imienia gospodarza
# (`config('kuking.community.host_name')`, dziś „Ula") i „z Kuking"
# (config/mail.php). Odkomentuj i ustaw tylko, żeby to doraźnie nadpisać —
# inaczej gospodarz zmienia się w JEDNYM miejscu, `KUKING_HOST_NAME` niżej,
# a nie tutaj i nie w szablonach.
# MAIL_FROM_NAME="Ula z Kuking"

# Imię gospodarza — podpis pod wiadomościami od serwisu (KUKING_HOST_USERNAME
# wyżej to inne pole: nazwa KONTA, którą czyta mechanizm auto-obserwowania).
KUKING_HOST_NAME=Ula

# --------------------------------------------------------------------------
# Monitoring i analityka
# --------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Powiadomienie o błędzie 500 na Slacku/Discordzie (config/logging.php,
# kanał `blad_webhook`) — rozwiązanie na czas, zanim da się zainstalować
# Sentry (`docs/infra/MONITORING_BLEDOW.md`). Jak założyć w 5 minut, co
# zobaczysz i jak wyłączyć: `docs/infra/MONITORING_BLEDOW.md`.
#
# PUSTE = KANAŁ WYŁĄCZONY. Nic się nie wysyła i nic nie pada — to jest
# stan domyślny lokalnie, w CI i w testach. Wpisz adres webhooka TYLKO
# w środowisku, w którym naprawdę chcesz dostawać powiadomienia.
#
# Adres z Discorda kończy się na `/slack` (ustawienia kanału → Integracje
# → Webhooki → skopiuj adres → dopisz `/slack` na końcu) — Discord przyjmuje
# wtedy dokładnie ten sam format, co prawdziwy Slack.
#
# Treść wysyłana na ten adres NIE ZAWIERA danych osobowych: sama klasa
# wyjątku, komunikat, plik:linia i wzorzec trasy (`App\Logging\WebhookBleduHandler`,
# AGENTS.md §7). Mimo to traktuj ten adres jak sekret — kto go pozna, może
# wysyłać wiadomości na twój kanał.
LOG_BLAD_WEBHOOK_URL=

# --------------------------------------------------------------------------
# Ustawienia produktowe Kuking (patrz config/kuking.php)
# --------------------------------------------------------------------------
# Skrzynka pokazywana ludziom (pouczenia DSA, ekran „Nie pamiętam hasła",
# polityka prywatności). MUSI być tym samym adresem co MAIL_FROM_ADDRESS —
# pilnuje tego test `DokumentyPrawneNieKlamiaTest`.
KUKING_CONTACT_EMAIL="kontakt@kuking.pl"

KUKING_MEDIA_MAX_BYTES=15728640
KUKING_MEDIA_MAX_MEGAPIXELS=50
KUKING_FEED_PAGE_SIZE=15
KUKING_REGISTRATION_OPEN=true
KUKING_MIN_AGE=16

# Wyłącznik awaryjny idempotencji formularzy (D-027). `false` → formularze
# przestają wysyłać ukryty klucz, serwis wraca do zachowania sprzed D-027
# (z duplikatami, ale bez ryzyka zablokowanej wysyłki). Jedyne wycofanie,
# które nie wymaga wdrożenia migracji.
KUKING_KLUCZ_WYSLANIA=true

# --------------------------------------------------------------------------
# Cloudflare Turnstile (D-050, issue #217)
# --------------------------------------------------------------------------
# Sprawdzenie „czy to człowiek" na SZEŚCIU formularzach publicznych:
# /register, /login, /nie-pamietam-hasla, /cofnij-usuniecie-konta,
# /napisz-do-nas, /zglos-nielegalna-tresc. Tryb Managed przechodzi zwykle
# bez żadnej interakcji — nie ma obrazków do klikania.
#
# Z KLUCZAMI JAVASCRIPT JEST NA TYCH SZEŚCIU FORMULARZACH OBOWIĄZKOWY:
# brak tokenu odrzuca wysłanie (D-050, zaostrzenie z 9 września 2026).
# Człowiek bez skryptu dostaje ramkę `<noscript>` z instrukcją i adresem
# e-mail; człowiek, któremu widget się nie dociągnął — osobny komunikat.
#
# PUSTE = TURNSTILE WYŁĄCZONY. Widget się nie renderuje, walidacja nikogo nie
# zatrzymuje, żaden formularz się nie psuje — to jest stan domyślny lokalnie,
# w CI i w testach. Wpisanie kluczy jest jedyną rzeczą, którą trzeba zrobić,
# żeby ochrona ruszyła.
#
# ALE NA PRODUKCJI CISZA JEST ZAKAZANA: gdy APP_ENV=production, którekolwiek
# miejsce w `config/kuking.php` jest włączone (domyślnie wszystkie), a kluczy
# nie ma — `/health` oddaje `status: degraded` z powodem `turnstile_bez_kluczy`
# i zapisuje błąd w dzienniku. Inaczej mielibyśmy narzędzie, które melduje
# sukces, nie robiąc nic.
#
# Skąd wziąć: Cloudflare → Turnstile → Add widget → domena kuking.pl, tryb
# Managed. Site Key jest publiczny (wchodzi do HTML-a). SECRET KEY JEST
# SEKRETEM — w Railway zaznacz „Sealed". Krok po kroku:
# `docs/infra/DEPLOYMENT_RUNBOOK.md`, krok 8A.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Ile sekund czekamy na odpowiedź `siteverify`. Krótko celowo: cudza usługa
# stoi w środku wysyłania naszego formularza, a jej niedostępność NIE MOŻE
# zamykać rejestracji (wtedy przepuszczamy i logujemy ostrzeżenie).
TURNSTILE_LIMIT_CZASU=4

# Gdzie Turnstile obowiązuje. Wszystkie siedem jest domyślnie WŁĄCZONYCH
# (decyzja właściciela, issue #217: „captcha trzeba normalnie zrobić, ten od
# cloudflare jest nieinwazyjny"). Odkomentuj tylko, żeby coś WYŁĄCZYĆ.
#
# Wyłączenie wszystkiego naraz to wyczyszczenie dwóch kluczy wyżej — nie
# trzeba wtedy ruszać tych siedmiu.
# TURNSTILE_NA_REJESTRACJI=true
# TURNSTILE_NA_LOGOWANIU=true
# TURNSTILE_NA_ODZYSKANIU_HASLA=true
# TURNSTILE_NA_COFNIECIU_USUNIECIA=true
# TURNSTILE_NA_KONTAKCIE=true
# TURNSTILE_NA_ZGLOSZENIU=true
# TURNSTILE_NA_LOGOWANIU_LINKIEM=true

# --------------------------------------------------------------------------
# Logowanie linkiem e-mail — „magic link" (issue #25, D-056)
# --------------------------------------------------------------------------
# Droga wejścia dla osób, które gubią hasła. Hasło zostaje jako droga
# równoległa — ta funkcja niczego nikomu nie odbiera.
#
# KUKING_LOGOWANIE_LINKIEM=false wyłącza CAŁĄ drogę bez wdrażania migracji:
# wejście z ekranu logowania znika, formularz i linki w drodze odpowiadają
# ekranem „zaloguj się hasłem". To jest droga wycofania z D-056.
#
# BUDŻET to sufit LISTÓW NA DOBĘ dla tej jednej funkcji. EmailLabs na planie
# darmowym daje 300 listów dziennie na CAŁY serwis (D-047) — bez tego sufitu
# fala próśb o linki zjada pulę potwierdzeń rejestracji. Po wykupieniu
# większego planu u dostawcy to jest jedna liczba do podniesienia.
# KUKING_LOGOWANIE_LINKIEM=true
# KUKING_LOGOWANIE_LINKIEM_WAZNOSC=30
# KUKING_LOGOWANIE_LINKIEM_BUDZET=120

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Sygnały automatu — wykrywacz podejrzanych treści (D-052)
# --------------------------------------------------------------------------
# Automat czyta świeżo opublikowane wpisy i komentarze i — gdy znajdzie znany
# wzorzec ogłoszenia, odnośnik zewnętrzny u świeżego konta albo powtórzoną
# treść tego samego konta — stawia JEDNĄ pozycję w kolejce moderatora
# (`/admin/sygnaly`). Na tym kończy się wszystko, co robi: treść zostaje
# widoczna, autor niczego nie zauważa, nikomu nic się nie dzieje.
#
# JEDEN WYŁĄCZNIK NA CAŁOŚĆ. `false` zatrzymuje analizę u źródła — nowe
# oznaczenia nie powstają, istniejące zostają do rozpatrzenia.
# KUKING_SYGNALY_AUTOMATU=true

# Progi. Domyślne wartości i pełne uzasadnienie każdej liczby, wraz z listą
# spodziewanych fałszywych alarmów: `docs/legal/SYGNALY_AUTOMATU.md`.
# KUKING_SYGNAL_POWTORZENIE_MINUT=60
# KUKING_SYGNAL_POWTORZENIE_ZNAKOW=40
# KUKING_SYGNAL_POWTORZENIE_PODOBIENSTWO=0.92
# KUKING_SYGNAL_POWTORZENIE_LIMIT=20
# KUKING_SYGNAL_SWIEZE_KONTO_DNI=7
# KUKING_SYGNAL_SWIEZE_KONTO_TRESCI=3

# Domeny, których NIE liczymy jako „odnośnik zewnętrzny" — serwisy, Z KTÓRYCH
# ludzie do nas przychodzą. Odnośnik do starego profilu w Garnku w pierwszym
# wpisie jest rzeczą oczekiwaną, nie podejrzaną.
# KUKING_SYGNAL_DOMENY_BEZ_SYGNALU=garnek.pl,kuking.pl

# --------------------------------------------------------------------------
# Druga para oczu: model oceniający treść i zdjęcia (D-054)
# --------------------------------------------------------------------------
# OpenAI `omni-moderation-latest` — bezpłatne API oceniające TEKST i OBRAZY
# pod kątem nienawiści, przemocy, treści seksualnych i samookaleczenia.
#
# TO ŁAPIE INNĄ KLASĘ TREŚCI NIŻ SYGNAŁY WYŻEJ: tamte szukają spamu, tego
# model nie ocenia w ogóle. Uzupełnienie, nie zamiennik.
#
# PUSTY KLUCZ = FUNKCJA WYŁĄCZONA. Żadne żądanie nie wychodzi, nic nie pada —
# tak jest lokalnie, w CI i w testach.
#
# UWAGA PRAWNA: włączenie tego wysyła treść wpisów i pomniejszone zdjęcia do
# podmiotu w USA. Jest to opisane w `resources/legal/polityka-prywatnosci.md`
# (tabela podmiotów przetwarzających + akapit o przekazywaniu poza EOG)
# i w `resources/legal/zasady.md` punkt 12. Nie wolno tego włączyć, jeśli
# któryś z tych zapisów zniknie.
OPENAI_MODERATION_KEY=

# Progi. Model podnosi rękę, nigdy nie zamyka drzwi — te liczby zmieniają
# WYŁĄCZNIE liczbę pozycji w kolejce moderatora.
# KUKING_MODEL_PROG=0.5
# KUKING_MODEL_PROG_PILNY=0.2
# KUKING_MODEL_OCENIA_ZDJECIA=true
# KUKING_MODEL_ZDJEC_NA_WPIS=2
# KUKING_MODEL_LIMIT_CZASU=8

# Adres, na który idą listy o kolejce. PUSTY = bez poczty, zostaje sama
# kolejka w panelu. Listy natychmiastowe wychodzą WYŁĄCZNIE przy treściach
# seksualnych i wszystkim, co dotyczy dzieci; reszta raz dziennie, jednym
# podsumowaniem (`kuking:podsumowanie-automatu`, 07:00). Powód jest
# praktyczny: EmailLabs na planie darmowym daje 300 listów dziennie,
# dzielone z potwierdzeniami rejestracji.
KUKING_MODEL_ALARM_EMAIL=
