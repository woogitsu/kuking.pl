# ==========================================================================
# Kuking.pl — przykładowa konfiguracja środowiska
# Skopiuj do .env i uzupełnij. NIGDY nie commituj pliku .env.
# ==========================================================================

APP_NAME=Kuking
APP_ENV=local
APP_KEY=
# Tylko w trakcie rotacji APP_KEY: poprzednie klucze po przecinku, bez spacji
# (docs/infra/DEPLOYMENT_RUNBOOK.md, krok 15, „Rotacja APP_KEY”).
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL
APP_TIMEZONE=Europe/Warsaw

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Baza danych — PostgreSQL (produkcja: PostgreSQL 18 na Railway)
# --------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kuking
DB_USERNAME=kuking
DB_PASSWORD=kuking
# Railway wstrzykuje DATABASE_URL — Laravel odczyta je przez DB_URL.
# DB_URL=

# --------------------------------------------------------------------------
# Sesje, cache, kolejka
# MVP celowo nie używa Redisa — dopiero po zmierzonej potrzebie.
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --------------------------------------------------------------------------
# Zaufanie do nagłówków od proxy (config/proxy.php, ustalenie SEC-01)
# --------------------------------------------------------------------------
# Ile wpisów w `X-Forwarded-For` dopisuje TWOJA infrastruktura. Aplikacja
# czyta adres klienta jako n-ty wpis OD KOŃCA łańcucha — proxy dopisuje na
# końcu, klient może dopisywać tylko na początku, więc tylko liczenie od
# prawej jest odporne na podstawienie.
#
#   0  — nie ufaj temu nagłówkowi wcale (dev bez proxy, `php artisan serve`);
#   1  — jedno proxy przed aplikacją (np. samo Cloudflare). WARTOŚĆ DOMYŚLNA;
#   2  — dwa (np. Cloudflare + brzeg platformy, JEŚLI ten drugi dopisuje wpis).
#
# Zmierz, zanim zmienisz: wejdź przez swoje proxy BEZ własnego nagłówka
# `X-Forwarded-For` i policz, ile wpisów dotarło do aplikacji. Za mała
# wartość jest niegroźna (wspólny adres → zbyt ostre limity); za duża
# przywraca podatność, bo odczyt wchodzi w obszar wypełniany przez klienta.
KUKING_ZAUFANE_PRZESKOKI=0

# --------------------------------------------------------------------------
# Pliki i zdjęcia
# local — dysk lokalny (dev). r2 — Cloudflare R2 (staging/produkcja).
# --------------------------------------------------------------------------
FILESYSTEM_DISK=local
# Pusty = podąża za FILESYSTEM_DISK. Ustaw tylko, gdy zdjęcia mają leżeć
# gdzie indziej niż reszta plików.
KUKING_MEDIA_DISK=public

# Cloudflare R2 (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Bucket WARIANTÓW (przetworzone pliki WebP). Nazwa zmiennej mówi „PUBLIC",
# ale od W7-02 ten bucket NIE MA już własnej domeny: adresem zdjęcia jest
# trasa aplikacji /zdjecia/{id}/{wariant}, która pyta Policy treści nadrzędnej
# i przekierowuje na adres podpisany na kilka minut. Brak EXIF-u nie znaczy
# „wolno pokazać każdemu" — wariant przepisu prywatnego jest prywatny.
# AWS_BUCKET wyżej trzyma ORYGINAŁY i tym bardziej nie może mieć ani własnej
# domeny, ani włączonego r2.dev: leży w nich pełny EXIF z GPS-em.
# Na R2 publiczność jest cechą bucketu, nie obiektu (audyt G-01).
AWS_PUBLIC_BUCKET=
# PUBLICZNE ADRESY OBU BUCKETÓW — LISTA DLA BRAMKI, NIE DLA KODU SERWUJĄCEGO.
# Czyta to WYŁĄCZNIE `php artisan kuking:bramka-r2`: pod każdy z tych adresów
# wysyła zwykły GET po prawdziwy oryginał z bazy — bez podpisu i bez nagłówka
# autoryzacji — i wymaga odmowy. Kod serwujący zdjęcia tej listy nie czyta.
# WPISZ TU TEŻ ADRESY, KTÓRE MAJĄ BYĆ WYŁĄCZONE. To nie pomyłka: wyłączenie
# `r2.dev` jest udowodnione dopiero wtedy, gdy spod `pub-….r2.dev` przyszła
# odmowa. Adres, którego nikt nie zadeklarował, nie zostanie zapytany, a
# niezapytany adres nie jest dowodem na nic — bramka liczy puste jak
# NIE WIEMY, czyli jak nieprzejście (issue #120).
# Rozdzielone przecinkami, z protokołem, bez klucza na końcu. Na przykład:
# KUKING_R2_PUBLICZNE_ADRESY=https://cdn.kuking.pl,https://pub-abc123.r2.dev
KUKING_R2_PUBLICZNE_ADRESY=
# Bucket na paczki z danymi (RODO). Prywatny, bez własnej domeny — to kopia
# całego konta. Osobny od oryginałów, bo ma inny cykl życia (TTL 7 dni).
AWS_EXPORTS_BUCKET=
# Stary, jeden bucket sprzed rozdzielenia oryginałów i wariantów. Wypełnij
# TYLKO wtedy, gdy w tym środowisku są już zdjęcia zapisane przed zmianą —
# ich pliki nadal tam leżą, dopóki `kuking:przenies-zdjecia` ich nie przeniesie.
AWS_LEGACY_BUCKET=
# Własna domena STAREGO bucketu. Po W7-02 to jedyny adres zdjęć, który jeszcze
# jest publiczny — i jedyny, który `PurgePublicMediaCache` ma co czyścić.
AWS_LEGACY_URL=

# --------------------------------------------------------------------------
# Kopia bazy poza Railwayem — CZUJKA po stronie aplikacji (issue #193, D-043)
# --------------------------------------------------------------------------
# Sam ZRZUT robi osobny serwis Railway w obrazie bez PHP (`docker/kopia/`)
# i on ma własne zmienne (`KOPIA_*`, patrz `.railway/railway.ts`). Aplikacja
# nie zapisuje do tego bucketu NICZEGO — dostaje token TYLKO DO CZYTANIA,
# żeby dało się zauważyć, że kopie przestały powstawać
# (`kuking:sprawdz-kopie`, `routes/console.php`).
#
# PUSTE = CZUJKA WYŁĄCZONA i tak jest dziś: bucket jeszcze nie istnieje
# (#120). Komenda mówi wtedy wprost, że nikt nie patrzy, i nie dzwoni nigdzie.
#
# OSOBNY BUCKET, nie prefiks w buckecie zdjęć: publiczność w R2 jest cechą
# BUCKETU, nie obiektu (audyt G-01), a to jest komplet danych osobowych
# wszystkich kont w jednym pliku.
AWS_KOPIE_BUCKET=
AWS_KOPIE_ACCESS_KEY_ID=
AWS_KOPIE_SECRET_ACCESS_KEY=
# Musi być tym samym prefiksem, co `KOPIA_PREFIKS` w serwisie kopii —
# rozjazd daje czujkę, która zawsze widzi pusty katalog i zawsze krzyczy.
KUKING_KOPIE_PREFIKS=baza/
# 36 h: przy kopii raz na dobę jeden przebieg ma prawo wypaść, dwa już nie.
KUKING_KOPIE_MAKS_WIEK_GODZIN=36

# --------------------------------------------------------------------------
# Budżet połączeń PostgreSQL (issue #598)
# --------------------------------------------------------------------------
# Wyprowadzenie wszystkich czterech liczb: `docs/DATABASE.md`, rozdział
# „Budżet połączeń PostgreSQL".
#
# Pusty `LOG_BLAD_WEBHOOK_URL` (niżej) wyłącza tę czujkę tak samo, jak
# wyłącza kanał błędów 500 — liczy i zapisuje w dzienniku, ale nie wysyła
# nic. Tak jest dziś na produkcji.

# Ile połączeń MA PRAWO zająć dzisiejsza topologia (4 web + 1 kolejka
# + 1 harmonogram, podwojone na okno wdrożenia z migracją, plus zapas
# na administrację). Liczba POLICZONA — przy zmianie topologii przelicz
# ją razem z `docs/DATABASE.md`.
KUKING_POLACZENIA_BUDZET=16
# Ponad trzykrotność budżetu: przekroczenie znaczy wyciek połączeń albo
# procesy spoza planu, a nie „blisko limitu".
KUKING_POLACZENIA_PROG_OSTRZEGAWCZY=50
# Ćwiartka z 497 miejsc dostępnych na produkcji. Wyczerpanie puli jest
# awarią skokową, więc próg stoi daleko przed limitem, nie tuż przed nim.
KUKING_POLACZENIA_PROG_KRYTYCZNY=125
KUKING_POLACZENIA_CISZA_GODZIN=6

# --------------------------------------------------------------------------
# Czujka kolejki (issue #599)
# --------------------------------------------------------------------------
# Inwentarz alertów i to, które z nich naprawdę dzwonią:
# `docs/infra/MONITORING_BLEDOW.md` §7.
#
# Okno „co padło niedawno". Czujka pyta o ZDARZENIE, bo pole `kolejka`
# w `/health` liczy stan całej tabeli `failed_jobs` i przez cztery stare
# wpisy z 9 września 2026 stoi na czerwono nieprzerwanie.
KUKING_KOLEJKA_OKNO_GODZIN=3
# Worker chodzi z `--sleep=1`: 600 s czekania to nie „wolniej", tylko
# „nikt po to nie sięgnął".
KUKING_KOLEJKA_PROG_ZALEGLOSCI=600
# Dwukrotność `DB_QUEUE_RETRY_AFTER` (960 s) — po tym czasie rezerwację
# zwalnia sama kolejka, więc starsza znaczy, że nie chodzi nikt.
KUKING_KOLEJKA_PROG_ZAWIESZENIA=1920
KUKING_KOLEJKA_CISZA_GODZIN=3

AWS_ENDPOINT=
# UWAGA: to NIE jest już adres zdjęć. Dysk `r2_publiczne` świadomie nie ma
# klucza `url` (W7-02), więc ta zmienna zasila wyłącznie zapasowy dysk `s3`
# i historyczne środowiska ze starym, jednym bucketem. Wdrożenie na Railway
# jej nie ustawia.
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# Poczta transakcyjna
#
# Co serwis wysyła mailem: potwierdzenie adresu przy rejestracji, link do
# ustawienia nowego hasła, „Twoje dane są gotowe" oraz cztery listy
# moderacyjne do zgłaszających (DSA). Tygodniowego digestu NIE MA jeszcze
# w kodzie — mimo że `docs/decyzje/POCZTA.md` liczy na nim wolumen.
#
# UWAGA — `log` NIE WYSYŁA NIC.
# Zapisuje wiadomość do `storage/logs` i zwraca sukces: rejestracja kończy
# się zieloną stroną, zadanie w kolejce kończy się bez błędu, a do nikogo
# nic nie dociera. Dla lokalnego rozwoju to jest w porządku. NA PRODUKCJI
# NIE — pierwsza osoba, która zapomni hasła, straci konto bezpowrotnie.
# Serwis o tym wie: przy `log` ekran „Nie pamiętam hasła" świadomie nie
# przyjmuje adresu i odsyła do skrzynki kontaktowej (`App\Support\Poczta`).
#
# Sterowniki, które NAPRAWDĘ wysyłają: `emaillabs`, `smtp`, `postmark`,
# `resend`, `ses`.
#
# NA PRODUKCJI JEST `emaillabs` I NIE JEST TO KWESTIA GUSTU.
# Railway wyłącza ruch SMTP na planach Free, Trial i Hobby, a właściciel jest
# na Free i przechodzi na Hobby. Na tych planach `smtp` nie kończy się błędem,
# tylko WISI: zadanie w kolejce wchodzi w `RUNNING` i nigdy nie osiąga ani
# `DONE`, ani `FAIL`. Patrz docs/DECISIONS.md D-047.
#
# Instrukcja krok po kroku (zmienne, DNS, weryfikacja): docs/infra/POCZTA_URUCHOMIENIE.md
# Sprawdzenie, że poczta wychodzi:  php artisan kuking:sprawdz-poczte ty@wp.pl
# --------------------------------------------------------------------------
MAIL_MAILER=log

# Sterownik `emaillabs` — wysyłka przez API HTTPS (bez SMTP, bez paczek).
#
# DWA KLUCZE, NIE JEDEN: żądanie niesie nagłówek `Application-Key` (pierwsza
# zmienna) i `Authorization` (druga, 128 znaków). Oba generuje się razem
# w panelu EmailLabs: Konto → Ustawienia → API → „Generuj klucz API".
# TO NIE SĄ LOGIN I HASŁO SMTP — API ich nie przyjmie i odpowie 401.
EMAILLABS_APP_KEY=
EMAILLABS_SECRET_KEY=
# Konto wysyłkowe w kształcie `1.nazwa.smtp` — pole `smtpAccount` w każdym
# żądaniu API. Znajdziesz je w panelu przy koncie SMTP.
EMAILLABS_SMTP_ACCOUNT=
# Adres API. Zmieniaj tylko wtedy, gdy dostawca ogłosi nowy — musi być HTTPS.
# EMAILLABS_ENDPOINT=https://api.emaillabs.io/v2.1/email
# Śledzenie odnośników. WYŁĄCZONE domyślnie: włączone podmienia każdy link
# w liście na adres przekierowujący dostawcy, a link do zmiany hasła
# prowadzący pod obcą domenę wygląda dla osoby 60+ jak phishing.
# EMAILLABS_TRACKING=false

# Poniższe dotyczą WYŁĄCZNIE sterownika `smtp`, który na dzisiejszym planie
# Railway NIE DZIAŁA (patrz wyżej) — zostają na wypadek planu Pro i dla
# Mailpita na własnej maszynie. Wartości niżej to zaślepki, nie serwer
# żadnego dostawcy: przy `MAIL_MAILER=smtp` każda wysyłka padnie na
# „connection refused".
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Symfony przyjmuje TYLKO `smtp` i `smtps`. `smtp` dla portu 587 (STARTTLS
# negocjuje się samo), `smtps` dla portu 465. Wartość `tls` wygląda sensownie
# i NIE DZIAŁA — transport się nie buduje, a każdy list kończy się `FAIL`.
MAIL_SCHEME=null

# Sterownik `postmark` — klucz z panelu (Server API Token).
POSTMARK_API_KEY=
# Sterownik `resend` — klucz z panelu.
RESEND_API_KEY=
# Sterownik `ses` — WŁASNE zmienne, nie `AWS_*`.
# `AWS_ACCESS_KEY_ID` i `AWS_DEFAULT_REGION` wyżej należą do Cloudflare R2
# (zdjęcia) i mają region `auto`, którego Amazon nie zna. Patrz komentarz
# przy kluczu `ses` w `config/services.php`.
MAIL_SES_KEY=
MAIL_SES_SECRET=
MAIL_SES_REGION=eu-central-1

# Adres nadawcy MUSI być skrzynką, którą ktoś czyta — żadnego `noreply@`
# (docs/brand/BRAND_EXTENDED.md). To ten sam adres co KUKING_CONTACT_EMAIL:
# pokazujemy ludziom i wysyłamy z jednego, żeby dało się odpisać.
MAIL_FROM_ADDRESS="kontakt@kuking.pl"
# NIEUSTAWIONE CELOWO: nazwa nadawcy domyślnie składa się z imienia gospodarza
# (`config('kuking.community.host_name')`, dziś „Ula") i „z Kuking"
# (config/mail.php). Odkomentuj i ustaw tylko, żeby to doraźnie nadpisać —
# inaczej gospodarz zmienia się w JEDNYM miejscu, `KUKING_HOST_NAME` niżej,
# a nie tutaj i nie w szablonach.
# MAIL_FROM_NAME="Ula z Kuking"

# Imię gospodarza — podpis pod wiadomościami od serwisu (KUKING_HOST_USERNAME
# wyżej to inne pole: nazwa KONTA, którą czyta mechanizm auto-obserwowania).
KUKING_HOST_NAME=Ula

# --------------------------------------------------------------------------
# Tygodniowe podsumowanie (digest) — issue #11, docs/DECISIONS.md D-057
# --------------------------------------------------------------------------
# JEDYNA POCZTA, KTÓREJ NIKT NIE ZAMÓWIŁ KLIKNIĘCIEM TUŻ PRZED WYSŁANIEM.
# Dlatego jest DOMYŚLNIE WYŁĄCZONA i włącza ją człowiek, po sprawdzeniu listu
# na własnej skrzynce:
#
#     php artisan kuking:wyslij-podsumowania --na-sucho
#     php artisan kuking:wyslij-podsumowania --tylko=woogitsu
#
# `false` tutaj to jedyne, co trzeba zmienić, żeby zatrzymać całą wysyłkę —
# bez wdrożenia, bez migracji, bez ruszania harmonogramu.
KUKING_DIGEST_WLACZONY=false

# DOBOWY SUFIT PODSUMOWAŃ.
#
# Konto EmailLabs na planie STARTUP ma limit 300 listów NA DOBĘ dla CAŁEGO
# serwisu (docs/decyzje/POCZTA.md §1). Podział całego wiadra:
#
#   120  logowanie linkiem e-mail   (KUKING_LOGOWANIE_LINKIEM_BUDZET)
#    60  tygodniowe podsumowanie    (ta zmienna)
#   100  rezerwa transakcyjna       (KUKING_POCZTA_REZERWA)
#    20  zapas
#   ---
#   300
#
# Suma sufitów i rezerwy MUSI zmieścić się pod limitem — pilnuje tego
# `PodzialLimituPocztyTest`. Podniesienie tej liczby bez obniżenia innej
# kończy się tym, że w tygodniu fali rejestracji ludzie nie mogą potwierdzić
# adresu, bo wyszedł biuletyn.
#
# Przepustowość: 60 × 7 = 420 osób tygodniowo. Powyżej tego progu plan
# darmowy przestaje wystarczać — patrz tabela w D-057.
KUKING_DIGEST_DZIENNY_LIMIT=60

# Limit dostawcy (na dobę, na całe konto) i ile listów zostawiamy wolnych
# na pocztę BEZ sufitu: potwierdzenia rejestracji, przypomnienia haseł,
# ostrzeżenia o zmianie adresu, powiadomienia moderacyjne. Te dwie liczby
# zmieniają się tylko razem ze zmianą planu u dostawcy — i wtedy razem
# z docs/decyzje/POCZTA.md.
KUKING_POCZTA_LIMIT_DOBOWY=300
KUKING_POCZTA_REZERWA=100

# ─────────────────────────────────────────────────────────────────────────
#  LIST, KTÓRY NIE WYSZEDŁ (issue #234, docs/DECISIONS.md D-062)
# ─────────────────────────────────────────────────────────────────────────
#
# Gdy dostawca nie przyjmie listu, worker robi trzy próby w sześć minut,
# a potem zadanie ląduje w `failed_jobs`. Do 10 września 2026 na tym się
# kończyło: nikt się nie dowiadywał, że komuś nie doszło potwierdzenie
# rejestracji. Teraz zostaje wiersz w `mail_failures`, a `/health` mówi
# `degraded` — dopóki nie odhaczysz:
#
#     php artisan kuking:nieudane-listy            # co przepadło i dlaczego
#     php artisan kuking:nieudane-listy --odhacz   # gasi alarm
#
# Ile dni trzymamy ODHACZONE ślady (nieodhaczonych nie kasuje nic i nigdy —
# to jedyna wiedza o tym, że list przepadł). Zero wyłącza sprzątanie.
KUKING_POCZTA_RETENCJA_DNI=90

# Po ilu PROCENTACH zużycia dobowego sufitu ostrzegamy w dzienniku, ZANIM
# pula się skończy. Raz na dobę na funkcję. 100 wyłącza ostrzeganie.
KUKING_POCZTA_PROG_OSTRZEZENIA=80

# Ile godzin ekran „Potwierdź adres e-mail" mówi człowiekowi, że jego list
# nie wyszedł (i nie odsyła go wtedy do folderu „Spam" po wiadomość, której
# tam nie ma). Po tym czasie zostaje sam przycisk „Wyślij jeszcze raz".
KUKING_POCZTA_OKNO_PRAWDY_GODZIN=24

# Najkrótszy odstęp między dwoma listami do TEJ SAMEJ osoby, w dniach.
# Tu mieszka obietnica „jeden e-mail tygodniowo, nigdy więcej" z ekranu
# /ustawienia/prywatnosc. Nie zmniejszaj poniżej 7.
KUKING_DIGEST_ODSTEP_DNI=7

# Okno, z którego list bierze treść. Tyle samo co odstęp.
KUKING_DIGEST_OKNO_DNI=7

# Odstęp między kolejnymi listami w kolejce, w sekundach. Sto dwadzieścia
# wiadomości w jednej minucie jest samo w sobie sygnałem spamowym
# (docs/decyzje/POCZTA.md §5 pkt 5); przy 20 s cała paczka schodzi w około
# czterdzieści minut.
KUKING_DIGEST_ODSTEP_SEKUND=20

# Ile pozycji najwyżej w każdej sekcji listu. Trzy — więcej zamienia list
# w katalog (docs/product/RETENTION_LOOPS.md §4.3).
KUKING_DIGEST_MAX_POZYCJI=3

# JEDNO ZDANIE OD GOSPODARZA na końcu listu — jedyna część treści, którą
# właściciel zmienia co tydzień, bez wdrożenia. Puste = akapitu nie ma.
# Samo pytanie NIE wystarcza, żeby list wyszedł: pusty list nie wychodzi
# nigdy, a jedno zdanie identyczne dla wszystkich nie jest podsumowaniem.
KUKING_DIGEST_PYTANIE="Czy gotujesz w tym tygodniu coś, czego nikt u nas jeszcze nie pokazał? Napisz, jestem ciekawa."

# --------------------------------------------------------------------------
# Monitoring i analityka
# --------------------------------------------------------------------------

# UWAGA: TE DWIE ZMIENNE NIC DZIŚ NIE ROBIĄ — I TO JEST STAN ZAMIERZONY.
#
# Nie czyta ich ani jedna linijka PHP: w projekcie NIE MA pakietu
# `sentry/sentry-laravel` ani `config/sentry.php` (zmierzone 10 września 2026:
# `grep -c -i sentry composer.json` → 0). Wpisanie tu prawdziwego DSN-u NIE
# sprawi, że błędy zaczną gdziekolwiek docierać. To jest przygotowana
# instalacja na dzień, w którym Sentry wejdzie — warunek wejścia i pełne
# uzasadnienie: D-041 w `docs/DECISIONS.md`.
#
# Zdanie stoi tu, bo brak zdania już raz kosztował pracę: z tabeli stacku
# w `AGENTS.md` i z tych dwóch pustych zmiennych dało się wyczytać, że
# monitoring błędów jest podłączony, i ktoś na tym oparł całe rozumowanie
# o tym, że właściciel dowie się o awarii. Nie dowie się — nie tędy.
#
# Monitoring, który DZIAŁA dziś, stoi niżej w tej sekcji: LOG_BLAD_WEBHOOK_URL.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Analityka odwiedzin: Cloudflare Web Analytics (D-092) -----------------
#
# ODPOWIADA NA PYTANIE „SKĄD LUDZIE PRZYCHODZĄ I KTÓRE STRONY OGLĄDAJĄ".
# To jest ta rzecz, po którą sięga się po Google Analytics — z tą różnicą,
# że beacon Cloudflare nie stawia ŻADNEGO ciasteczka i nie zapisuje niczego
# na urządzeniu odwiedzającego (sprawdzone przez odczytanie pliku
# `beacon.min.js`, nie ze strony dostawcy). Dlatego serwis dalej nie
# potrzebuje banera zgody na cookies, a polityka prywatności może zostać
# przy zdaniu, że go nie ma (`resources/legal/polityka-prywatnosci.md`,
# sekcja 5).
#
# DLACZEGO CLOUDFLARE, A NIE PLAUSIBLE. Cena (decyzja właściciela) plus to,
# że Cloudflare już przetwarza każde żądanie do kuking.pl jako nasz CDN
# i WAF przed Railwayem — włączenie jego analityki nie wysyła mu ani jednego
# nowego bajta i nie dokłada dostawcy do polityki prywatności.
#
# NIE ZASTĘPUJE naszej własnej analityki (`App\Domain\Analytics\*`), która
# liczy „ile osób ugotowało w tym tygodniu" po stronie serwera. Tamta wie
# tylko o tym, co ktoś u nas ZROBIŁ; ta wie o kimś, kto wszedł i wyszedł.
#
# PUSTE = ANALITYKI NIE MA. Bez tokenu w HTML-u nie pojawia się ani jeden
# znacznik `<script>` i nic nigdzie nie wychodzi — to jest stan domyślny
# lokalnie, w testach i w CI, i tak ma zostać. Wpisz tę zmienną TYLKO
# w środowisku produkcyjnym (Railway → Variables).

# Token serwisu z panelu Cloudflare: Web Analytics → Add a site → kuking.pl.
# Cloudflare pokaże gotowy znacznik `<script>` z atrybutem `data-cf-beacon`
# — potrzebna jest sama wartość pola `token` z tego JSON-a, bez cudzysłowów.
# To NIE jest sekret (stoi w HTML-u każdej strony) i nie daje dostępu do
# panelu. Literówka nie wywoła żadnego błędu: skrypt się załaduje, zdarzenia
# pójdą, a Cloudflare po cichu je odrzuci i panel zostanie pusty.
#
# DRUGA CZYNNOŚĆ, O KTÓREJ ŁATWO ZAPOMNIEĆ: w panelu Cloudflare
# (Web Analytics → ustawienia serwisu) trzeba WYŁĄCZYĆ automatyczne
# wstrzykiwanie beacona przez proxy. Jeśli zostanie włączone, strona dostanie
# DWA beacony — nasz z layoutu i jeden wstrzyknięty w locie — czyli każda
# odsłona policzy się dwa razy, a nasze testy CSP będą opisywać nieprawdę.
# Znacznik stawiamy sami świadomie: wstrzyknięcie jest poza repozytorium,
# poza recenzją i poza testami, więc nie da się go ani przejrzeć, ani zepsuć
# w kontrolowany sposób.
#
# TRZECIA CZYNNOŚĆ, KTÓREJ SKUTEK JEST JESZCZE CICHSZY: w ustawieniach serwisu
# Cloudflare pozwala wybrać wariant WYKLUCZAJĄCY dane odwiedzających z Unii
# Europejskiej. Nasz ruch jest niemal w całości unijny, więc przy tym wariancie
# beacon działa, zdarzenia wychodzą, CSP je przepuszcza — a panel i tak zostaje
# pusty, bo Cloudflare odrzuca je u siebie. Z kontenera nie da się tego zmierzyć
# ani jednym pomiarem; sprawdza się to okiem, wg `docs/infra/DEPLOYMENT_RUNBOOK.md`
# KROK 8F.3.
#
# NA PRODUKCJI BRAK TEJ ZMIENNEJ JEST WIDOCZNY: `/health` oddaje wtedy
# `status: degraded` z powodem `analityka_bez_tokenu` — ale TYLKO dopóki
# `resources/legal/polityka-prywatnosci.md` obiecuje tę analitykę czytelnikom.
# Sygnał dotyczy ROZJAZDU między dokumentem prawnym a rzeczywistością, nie
# samego pustego pola; poza produkcją jest cisza.
CLOUDFLARE_ANALYTICS_TOKEN=

# Powiadomienie o błędzie 500 na Slacku/Discordzie (config/logging.php,
# kanał `blad_webhook`) — rozwiązanie na czas, zanim da się zainstalować
# Sentry (`docs/infra/MONITORING_BLEDOW.md`). Jak założyć w 5 minut, co
# zobaczysz i jak wyłączyć: `docs/infra/MONITORING_BLEDOW.md`.
#
# PUSTE = KANAŁ WYŁĄCZONY. Nic się nie wysyła i nic nie pada — to jest
# stan domyślny lokalnie, w CI i w testach. Wpisz adres webhooka TYLKO
# w środowisku, w którym naprawdę chcesz dostawać powiadomienia.
#
# Adres z Discorda kończy się na `/slack` (ustawienia kanału → Integracje
# → Webhooki → skopiuj adres → dopisz `/slack` na końcu) — Discord przyjmuje
# wtedy dokładnie ten sam format, co prawdziwy Slack.
#
# Treść wysyłana na ten adres NIE ZAWIERA danych osobowych: sama klasa
# wyjątku, kod błędu (np. SQLSTATE), plik:linia, wzorzec trasy i odcisk
# (`App\Logging\WebhookBleduHandler`, AGENTS.md §7). KOMUNIKAT WYJĄTKU
# ŚWIADOMIE NIE WYCHODZI — przy błędzie bazy komunikat buduje sterownik
# i wkłada w niego SQL razem z wartościami (adres e-mail, hash hasła,
# audyt A6-01, poprawione 9 września 2026). Mimo to traktuj ten adres jak
# sekret — kto go pozna, może wysyłać wiadomości na twój kanał.
#
# Ten sam kanał dzwoni też o awariach wykrytych WYŁĄCZNIE przez `/health`
# (Turnstile bez kluczy, poczta bez transportu, zaległe `failed_jobs`) —
# rzeczach, które nie rzucają żadnego wyjątku nigdzie indziej w serwisie.
LOG_BLAD_WEBHOOK_URL=

# --------------------------------------------------------------------------
# Ustawienia produktowe Kuking (patrz config/kuking.php)
# --------------------------------------------------------------------------
# Skrzynka pokazywana ludziom (pouczenia DSA, ekran „Nie pamiętam hasła",
# polityka prywatności). MUSI być tym samym adresem co MAIL_FROM_ADDRESS —
# pilnuje tego test `DokumentyPrawneNieKlamiaTest`.
KUKING_CONTACT_EMAIL="kontakt@kuking.pl"

KUKING_MEDIA_MAX_BYTES=15728640
KUKING_MEDIA_MAX_MEGAPIXELS=50
KUKING_FEED_PAGE_SIZE=15
KUKING_REGISTRATION_OPEN=true
KUKING_MIN_AGE=16

# Wyłącznik awaryjny idempotencji formularzy (D-027). `false` → formularze
# przestają wysyłać ukryty klucz, serwis wraca do zachowania sprzed D-027
# (z duplikatami, ale bez ryzyka zablokowanej wysyłki). Jedyne wycofanie,
# które nie wymaga wdrożenia migracji.
KUKING_KLUCZ_WYSLANIA=true

# --------------------------------------------------------------------------
# Cloudflare Turnstile (D-050, issue #217)
# --------------------------------------------------------------------------
# Sprawdzenie „czy to człowiek" na SZEŚCIU formularzach publicznych:
# /register, /login, /nie-pamietam-hasla, /cofnij-usuniecie-konta,
# /napisz-do-nas, /zglos-nielegalna-tresc. Tryb Managed przechodzi zwykle
# bez żadnej interakcji — nie ma obrazków do klikania.
#
# Z KLUCZAMI JAVASCRIPT JEST NA TYCH SZEŚCIU FORMULARZACH OBOWIĄZKOWY:
# brak tokenu odrzuca wysłanie (D-050, zaostrzenie z 9 września 2026).
# Człowiek bez skryptu dostaje ramkę `<noscript>` z instrukcją i adresem
# e-mail; człowiek, któremu widget się nie dociągnął — osobny komunikat.
#
# PUSTE = TURNSTILE WYŁĄCZONY. Widget się nie renderuje, walidacja nikogo nie
# zatrzymuje, żaden formularz się nie psuje — to jest stan domyślny lokalnie,
# w CI i w testach. Wpisanie kluczy jest jedyną rzeczą, którą trzeba zrobić,
# żeby ochrona ruszyła.
#
# ALE NA PRODUKCJI CISZA JEST ZAKAZANA: gdy APP_ENV=production, którekolwiek
# miejsce w `config/kuking.php` jest włączone (domyślnie wszystkie), a kluczy
# nie ma — `/health` oddaje `status: degraded` z powodem `turnstile_bez_kluczy`
# i zapisuje błąd w dzienniku. Inaczej mielibyśmy narzędzie, które melduje
# sukces, nie robiąc nic.
#
# Skąd wziąć: Cloudflare → Turnstile → Add widget → domena kuking.pl, tryb
# Managed. Site Key jest publiczny (wchodzi do HTML-a). SECRET KEY JEST
# SEKRETEM — w Railway zaznacz „Sealed". Krok po kroku:
# `docs/infra/DEPLOYMENT_RUNBOOK.md`, krok 8A.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Ile sekund czekamy na odpowiedź `siteverify`. Krótko celowo: cudza usługa
# stoi w środku wysyłania naszego formularza, a jej niedostępność NIE MOŻE
# zamykać rejestracji (wtedy przepuszczamy i logujemy ostrzeżenie).
TURNSTILE_LIMIT_CZASU=4

# ---------------------------------------------------------------------------
# WEJŚCIE KONTEM GOOGLE (issue #258, D-069)
# ---------------------------------------------------------------------------
#
# DROGA DODATKOWA, NIGDY JEDYNA. Hasło i wiadomość z linkiem do zalogowania
# zostają na ekranie logowania obok niej — część naszych ludzi ma adresy
# @wp.pl, @o2.pl i @interia.pl, gdzie konta Google nie ma.
#
# PUSTE = TEJ DROGI NIE MA. Przycisku nie ma na ekranie, trasy odsyłają na
# logowanie, nic się nie psuje — to jest stan domyślny lokalnie, w CI
# i w testach. Wpisanie dwóch kluczy jest jedyną rzeczą, którą trzeba zrobić.
#
# `/health` O BRAKU KLUCZY POWIE: na produkcji, z funkcją włączoną i bez
# kluczy, trasa oddaje `status: degraded` z powodem `google_bez_kluczy`
# (D-069). Poza produkcją brak kluczy jest stanem normalnym i nic nie zgłasza.
# Sprawdzenie okiem zostaje jako druga droga: wejdź na /login i zobacz, czy
# jest przycisk „Wejdź kontem Google".
#
# GOOGLE_CLIENT_ID jest publiczny (wchodzi do adresu, na który odsyłamy
# człowieka). GOOGLE_CLIENT_SECRET JEST SEKRETEM — w Railway zaznacz „Sealed".
#
# Skąd wziąć: Google Cloud Console → APIs & Services → Credentials → Create
# credentials → OAuth client ID → Web application. Adres powrotu wpisuje się
# CO DO ZNAKU: https://kuking.pl/wejdz/google/wroc (lokalnie:
# http://127.0.0.1:8000/wejdz/google/wroc). Krok po kroku:
# `docs/infra/DEPLOYMENT_RUNBOOK.md`, krok 8D.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WYŁĄCZNIK CAŁEJ FUNKCJI, z kluczami na miejscu — jedyna droga wycofania BEZ
# migracji. `false` zdejmuje przycisk i zamyka trasy; powiązania w bazie
# zostają, więc nikt nie traci dostępu (konto założone tą drogą ma
# potwierdzony adres, czyli zostaje mu link e-mail i „Nie pamiętam hasła").
# KUKING_WEJSCIE_GOOGLE=true

# Ile sekund czekamy na odpowiedź Google przy wymianie kodu. Dłużej niż przy
# Turnstile, bo tu nie ma wariantu „przepuszczamy bez sprawdzenia" — ale nie
# za długo, bo człowiek patrzy w tym czasie na pustą stronę.
# GOOGLE_LIMIT_CZASU=6

# Ile minut wolno stać na ekranie domknięcia konta (imię, nazwa, dwa
# oświadczenia), zanim rozpoznana tożsamość z Google przestanie się liczyć.
# Trzydzieści — ta sama liczba i ten sam wywód co przy linku (D-056):
# to jest ekran, na którym 65-latka czyta regulamin.
# GOOGLE_WAZNOSC_DOMKNIECIA=30

# ---------------------------------------------------------------------------
# WEJŚCIE KONTEM FACEBOOKA (issue #259, D-069, D-098)
# ---------------------------------------------------------------------------
#
# DROGA DODATKOWA, NIGDY JEDYNA — tak samo jak Google wyżej.
#
# PUSTE = TEJ DROGI NIE MA. Przycisku nie ma na ekranie, trasy odsyłają na
# logowanie, nic się nie psuje — to jest stan domyślny lokalnie, w CI,
# w testach ORAZ w każdym środowisku preview. To ostatnie nie jest usterką
# i nie ma sensu tego obchodzić: adresy `*.up.railway.app` są losowe, a Meta
# dopasowuje adres powrotu ZNAK W ZNAK i nie przyjmuje `*`
# (docs/infra/FACEBOOK_LOGIN_URUCHOMIENIE.md §4.4).
#
# CZYM TA DROGA RÓŻNI SIĘ OD GOOGLE — jednym zdaniem, bo od niego zależy
# bezpieczeństwo: Facebook NIE MÓWI, czy adres e-mail jest potwierdzony, więc
# adres z Facebooka nigdy nie łączy z istniejącym kontem Kuking, a nowe konto
# powstaje z adresem NIEPOTWIERDZONYM i dostaje naszą wiadomość „potwierdź
# adres" (D-098). Powiązanie istniejącego konta robi się w Ustawieniach →
# Bezpieczeństwo, będąc na nim zalogowanym.
#
# `/health` O BRAKU KLUCZY POWIE — tak samo jak przy Google: na produkcji,
# z funkcją włączoną i bez kluczy, trasa oddaje `status: degraded` z powodem
# `facebook_bez_kluczy`. Poza produkcją brak kluczy jest stanem normalnym.
# Sprawdzenie okiem zostaje jako druga droga: wejdź na /login i zobacz,
# czy jest przycisk „Wejdź kontem Facebooka".
#
# W PANELU META TE DWIE WARTOŚCI NAZYWAJĄ SIĘ INACZEJ: FACEBOOK_CLIENT_ID to
# **App ID**, a FACEBOOK_CLIENT_SECRET to **App Secret** (Settings → Basic →
# App Secret → „Show"). Nazwy zmiennych są symetryczne do GOOGLE_CLIENT_ID
# i GOOGLE_CLIENT_SECRET, bo to jest ta sama rola w tej samej drodze wejścia.
# App ID jest publiczny (wchodzi do adresu, na który odsyłamy człowieka);
# App Secret JEST SEKRETEM — w Railway zaznacz „Sealed". Tym samym sekretem
# weryfikuje się podpis żądania usunięcia danych od Meta, więc jego wyciek to
# nie tylko cudze logowanie; rotacja u Meta jest jednym przyciskiem („Reset").
#
# Adres powrotu wpisuje się u Meta CO DO ZNAKU:
# https://kuking.pl/wejdz/facebook/wroc (oraz www i staging). Krok po kroku,
# razem z tym, co właściciel ma zrobić w panelu:
# docs/infra/FACEBOOK_LOGIN_URUCHOMIENIE.md §4.2 i §12.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# WYŁĄCZNIK CAŁEJ FUNKCJI, z kluczami na miejscu — jedyna droga wycofania BEZ
# migracji. `false` zdejmuje przycisk i zamyka trasy; powiązania w bazie
# zostają, więc nikt nie traci konta.
#
# WYŁĄCZAJ ŚWIADOMIEJ NIŻ GOOGLE: konto z Google ma adres POTWIERDZONY, więc
# zostaje mu link e-mail. Konto z Facebooka ma adres niepotwierdzony, dopóki
# człowiek nie kliknie w naszą wiadomość — dla części tych osób zostaje więc
# „Nie pamiętam hasła", czyli droga dłuższa. Uprzedź je.
# KUKING_WEJSCIE_FACEBOOK=true

# WERSJA GRAPH API — JEDYNE MIEJSCE, w którym ten numer stoi (pusto = wartość
# z `App\Support\Facebook::WERSJA_GRAFU_DOMYSLNA`).
#
# To jest obowiązek, którego droga Google nie miała wcale: wersje Meta żyją
# „at least 2 years from release", a po wygaśnięciu wywołania NIE PADAJĄ —
# spadają CICHO na starszą wersję. Czyli działa do dnia, w którym przestanie,
# i nikt nie wie którego. Dlatego numer da się podnieść tą zmienną, bez
# wdrożenia kodu, a w przeglądzie kwartalnym
# (docs/infra/DEPLOYMENT_RUNBOOK.md) stoi pozycja „sprawdź, czy nasza wersja
# Graph API jeszcze żyje".
# FACEBOOK_GRAPH_WERSJA=v25.0

# Ile sekund czekamy na odpowiedź Facebooka. Ten sam wywód co przy Google,
# z jedną różnicą: tutaj wywołań jest DWA (token, potem tożsamość), więc
# w najgorszym razie człowiek czeka dwa razy tyle.
# FACEBOOK_LIMIT_CZASU=6

# Ile minut wolno stać na ekranie domknięcia konta albo na ekranie „połącz
# konto z Facebookiem". Trzydzieści — ta sama liczba i ten sam wywód co przy
# Google i przy linku do logowania (D-056).
# FACEBOOK_WAZNOSC_DOMKNIECIA=30

# Gdzie Turnstile obowiązuje. Wszystkie siedem jest domyślnie WŁĄCZONYCH
# (decyzja właściciela, issue #217: „captcha trzeba normalnie zrobić, ten od
# cloudflare jest nieinwazyjny"). Odkomentuj tylko, żeby coś WYŁĄCZYĆ.
#
# Wyłączenie wszystkiego naraz to wyczyszczenie dwóch kluczy wyżej — nie
# trzeba wtedy ruszać tych siedmiu.
# TURNSTILE_NA_REJESTRACJI=true
# TURNSTILE_NA_LOGOWANIU=true
# TURNSTILE_NA_ODZYSKANIU_HASLA=true
# TURNSTILE_NA_COFNIECIU_USUNIECIA=true
# TURNSTILE_NA_KONTAKCIE=true
# TURNSTILE_NA_ZGLOSZENIU=true
# TURNSTILE_NA_LOGOWANIU_LINKIEM=true

# --------------------------------------------------------------------------
# Logowanie linkiem e-mail — „magic link" (issue #25, D-056)
# --------------------------------------------------------------------------
# Droga wejścia dla osób, które gubią hasła. Hasło zostaje jako droga
# równoległa — ta funkcja niczego nikomu nie odbiera.
#
# KUKING_LOGOWANIE_LINKIEM=false wyłącza CAŁĄ drogę bez wdrażania migracji:
# wejście z ekranu logowania znika, formularz i linki w drodze odpowiadają
# ekranem „zaloguj się hasłem". To jest droga wycofania z D-056.
#
# BUDŻET to sufit LISTÓW NA DOBĘ dla tej jednej funkcji. EmailLabs na planie
# darmowym daje 300 listów dziennie na CAŁY serwis (D-047) — bez tego sufitu
# fala próśb o linki zjada pulę potwierdzeń rejestracji. Po wykupieniu
# większego planu u dostawcy to jest jedna liczba do podniesienia.
# KUKING_LOGOWANIE_LINKIEM=true
# KUKING_LOGOWANIE_LINKIEM_WAZNOSC=30
# KUKING_LOGOWANIE_LINKIEM_BUDZET=120

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Sygnały automatu — wykrywacz podejrzanych treści (D-052)
# --------------------------------------------------------------------------
# Automat czyta świeżo opublikowane wpisy i komentarze i — gdy znajdzie znany
# wzorzec ogłoszenia, odnośnik zewnętrzny u świeżego konta albo powtórzoną
# treść tego samego konta — stawia JEDNĄ pozycję w kolejce moderatora
# (`/admin/sygnaly`). Na tym kończy się wszystko, co robi: treść zostaje
# widoczna, autor niczego nie zauważa, nikomu nic się nie dzieje.
#
# JEDEN WYŁĄCZNIK NA CAŁOŚĆ. `false` zatrzymuje analizę u źródła — nowe
# oznaczenia nie powstają, istniejące zostają do rozpatrzenia.
# KUKING_SYGNALY_AUTOMATU=true

# Progi. Domyślne wartości i pełne uzasadnienie każdej liczby, wraz z listą
# spodziewanych fałszywych alarmów: `docs/legal/SYGNALY_AUTOMATU.md`.
# KUKING_SYGNAL_POWTORZENIE_MINUT=60
# KUKING_SYGNAL_POWTORZENIE_ZNAKOW=40
# KUKING_SYGNAL_POWTORZENIE_PODOBIENSTWO=0.92
# KUKING_SYGNAL_POWTORZENIE_LIMIT=20
# KUKING_SYGNAL_SWIEZE_KONTO_DNI=7
# KUKING_SYGNAL_SWIEZE_KONTO_TRESCI=3

# Domeny, których NIE liczymy jako „odnośnik zewnętrzny" — serwisy, Z KTÓRYCH
# ludzie do nas przychodzą. Odnośnik do starego profilu w Garnku w pierwszym
# wpisie jest rzeczą oczekiwaną, nie podejrzaną.
# KUKING_SYGNAL_DOMENY_BEZ_SYGNALU=garnek.pl,kuking.pl

# --------------------------------------------------------------------------
# Druga para oczu: model oceniający treść i zdjęcia (D-054)
# --------------------------------------------------------------------------
# OpenAI `omni-moderation-latest` — bezpłatne API oceniające TEKST i OBRAZY
# pod kątem nienawiści, przemocy, treści seksualnych i samookaleczenia.
#
# TO ŁAPIE INNĄ KLASĘ TREŚCI NIŻ SYGNAŁY WYŻEJ: tamte szukają spamu, tego
# model nie ocenia w ogóle. Uzupełnienie, nie zamiennik.
#
# PUSTY KLUCZ = FUNKCJA WYŁĄCZONA. Żadne żądanie nie wychodzi, nic nie pada —
# tak jest lokalnie, w CI i w testach.
#
# UWAGA PRAWNA: włączenie tego wysyła treść wpisów i pomniejszone zdjęcia do
# podmiotu w USA. Jest to opisane w `resources/legal/polityka-prywatnosci.md`
# (tabela podmiotów przetwarzających + akapit o przekazywaniu poza EOG)
# i w `resources/legal/zasady.md` punkt 12. Nie wolno tego włączyć, jeśli
# któryś z tych zapisów zniknie.
OPENAI_MODERATION_KEY=

# Progi. Model podnosi rękę, nigdy nie zamyka drzwi — te liczby zmieniają
# WYŁĄCZNIE liczbę pozycji w kolejce moderatora.
# KUKING_MODEL_PROG=0.5
# KUKING_MODEL_PROG_PILNY=0.2
# KUKING_MODEL_OCENIA_ZDJECIA=true
# KUKING_MODEL_ZDJEC_NA_WPIS=2
# KUKING_MODEL_LIMIT_CZASU=8

# Adres, na który idą listy o kolejce. PUSTY = bez poczty, zostaje sama
# kolejka w panelu. Listy natychmiastowe wychodzą WYŁĄCZNIE przy treściach
# seksualnych i wszystkim, co dotyczy dzieci; reszta raz dziennie, jednym
# podsumowaniem (`kuking:podsumowanie-automatu`, 07:00). Powód jest
# praktyczny: EmailLabs na planie darmowym daje 300 listów dziennie,
# dzielone z potwierdzeniami rejestracji.
KUKING_MODEL_ALARM_EMAIL=

# Dział pytań: wyłączony do ukończenia ścieżek odczytu i publikowania (#372).
KUKING_QUESTIONS_ENABLED=false

# Haslo do kont z DemoSeedera. Puste = seeder losuje je na kazdy przebieg
# i wypisuje na koniec. Nigdy nie wpisuj tu wartosci na stale.
KUKING_DEMO_HASLO=
