# ==========================================================================
# Kuking.pl — przykładowa konfiguracja środowiska
# Skopiuj do .env i uzupełnij. NIGDY nie commituj pliku .env.
# ==========================================================================

APP_NAME=Kuking
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL
APP_TIMEZONE=Europe/Warsaw

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Baza danych — PostgreSQL (produkcja: PostgreSQL 18 na Railway)
# --------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kuking
DB_USERNAME=kuking
DB_PASSWORD=kuking
# Railway wstrzykuje DATABASE_URL — Laravel odczyta je przez DB_URL.
# DB_URL=

# --------------------------------------------------------------------------
# Sesje, cache, kolejka
# MVP celowo nie używa Redisa — dopiero po zmierzonej potrzebie.
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --------------------------------------------------------------------------
# Pliki i zdjęcia
# local — dysk lokalny (dev). r2 — Cloudflare R2 (staging/produkcja).
# --------------------------------------------------------------------------
FILESYSTEM_DISK=local
# Pusty = podąża za FILESYSTEM_DISK. Ustaw tylko, gdy zdjęcia mają leżeć
# gdzie indziej niż reszta plików.
KUKING_MEDIA_DISK=public

# Cloudflare R2 (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Bucket PUBLICZNY — wyłącznie przetworzone warianty WebP, to on ma własną
# domenę (cdn.kuking.pl). AWS_BUCKET wyżej trzyma ORYGINAŁY i nie może mieć
# ani własnej domeny, ani włączonego r2.dev: leży w nich pełny EXIF z GPS-em.
# Na R2 publiczność jest cechą bucketu, nie obiektu (audyt G-01).
AWS_PUBLIC_BUCKET=
# Bucket na paczki z danymi (RODO). Prywatny, bez własnej domeny — to kopia
# całego konta. Osobny od oryginałów, bo ma inny cykl życia (TTL 7 dni).
AWS_EXPORTS_BUCKET=
# Stary, jeden bucket sprzed rozdzielenia oryginałów i wariantów. Wypełnij
# TYLKO wtedy, gdy w tym środowisku są już zdjęcia zapisane przed zmianą —
# ich pliki nadal tam leżą, dopóki `kuking:przenies-zdjecia` ich nie przeniesie.
AWS_LEGACY_BUCKET=
AWS_LEGACY_URL=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# Poczta transakcyjna (weryfikacja e-maila, reset hasła, digest)
# --------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="kuchnia@kuking.pl"
MAIL_FROM_NAME="Kuking"

# --------------------------------------------------------------------------
# Monitoring i analityka
# --------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --------------------------------------------------------------------------
# Ustawienia produktowe Kuking (patrz config/kuking.php)
# --------------------------------------------------------------------------
KUKING_MEDIA_MAX_BYTES=15728640
KUKING_MEDIA_MAX_MEGAPIXELS=50
KUKING_FEED_PAGE_SIZE=15
KUKING_REGISTRATION_OPEN=true
KUKING_MIN_AGE=16

VITE_APP_NAME="${APP_NAME}"
