*.log
.DS_Store
.env
# Cala rodzina, nie trzy nazwy z osobna. Decyzja wlasciciela 20.09.2026, po
# mutacji strazniku R47: wystarczylo zalozyc `.env.local`, zeby plik
# z poswiadczeniami wjechal do repozytorium bez jednego ostrzezenia.
# Lista nazw milczy, gdy dojdzie czwarta — wzorzec nie milczy.
# `.env.example` jest jedynym, ktory MA byc sledzony: to szablon bez sekretow.
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
/.codex
/.idea
/.nova
/.phpstan-cache
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
# Wynik automatu dostępności — świeży po każdym uruchomieniu, nie do repozytorium.
/storage/dostepnosc.json
# To samo dla automatu wydajności i SEO (Lighthouse, issue #26).
/storage/wydajnosc.json
# I dla audytu martwych przycisków (D-053) — pełna lista adresów z kodami.
/storage/martwe-przyciski.json
# Pomiary i zrzuty rzeczywistych kroków kreatora przepisu.
/storage/kroki-kreatora/
# Pomiar i zrzuty stopki (`scripts/stopka-pusty-pas.mjs --statycznie`).
/storage/stopka-pusty-pas/
# Wyniki strażnika kaskady CSS, pilotów AI i ręcznych przebiegów testów —
# świeże po każdym uruchomieniu, nie do repozytorium (audyt A4, 25.09.2026).
/storage/kaskada-martwe-reguly.json
/storage/ai-pilots/
/storage/*.log
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Katalogi robocze agentów AI (worktree gita) — nigdy do repozytorium.
/.claude/worktrees/

# Kuking — nie ignorujemy plików instrukcji dla agentów AI.
# .cursor/rules/ jest częścią repozytorium (patrz AGENTS.md, sekcja 1).
!/.cursor/rules/

# Znacznik wydania — pisze go build obrazu (Dockerfile), nie człowiek.
# W repozytorium nie ma czego trzymać: lokalnie stopka mówi „lokalnie".
/bootstrap/wydanie.txt

# Cache narzędzi do stylu kodu (Pint i php-cs-fixer). Zależy od maszyny,
# wersji PHP i ścieżek — w repozytorium jest tylko śmieciem i konfliktem.
.pint.cache
.php-cs-fixer.cache

# Bajtkod Pythona (skrypty w scripts/)
__pycache__/
*.pyc

# Stan monitora czuwania sesji głównej (docs/flota/chmura/czuwanie.py)
docs/flota/chmura/czuwanie-stan.json

# Skompilowany Python z uruchomień skryptów kontrolnych.
__pycache__/
