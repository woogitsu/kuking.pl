# Wynik automatu dostępności — świeży po każdym uruchomieniu, nie do repozytorium.
/storage/dostepnosc.json
# To samo dla automatu wydajności i SEO (Lighthouse, issue #26).
/storage/wydajnosc.json
# I dla audytu martwych przycisków (D-053) — pełna lista adresów z kodami.
/storage/martwe-przyciski.json
# I dla zrzutów portu układu (scripts/port-projektu.mjs) — zdjęcia ekranów, nie kod.
/storage/port-projektu/
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Katalogi robocze agentów AI (worktree gita) — nigdy do repozytorium.
/.claude/worktrees/

# Kuking — nie ignorujemy plików instrukcji dla agentów AI.
# .cursor/rules/ jest częścią repozytorium (patrz AGENTS.md, sekcja 1).
!/.cursor/rules/

# Znacznik wydania — pisze go build obrazu (Dockerfile), nie człowiek.
# W repozytorium nie ma czego trzymać: lokalnie stopka mówi „lokalnie".
/bootstrap/wydanie.txt

# Cache narzędzi do stylu kodu (Pint i php-cs-fixer). Zależy od maszyny,
# wersji PHP i ścieżek — w repozytorium jest tylko śmieciem i konfliktem.
.pint.cache
.php-cs-fixer.cache
