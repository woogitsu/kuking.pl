# =============================================================================
#  Kuking.pl — Caddyfile dla FrankenPHP
# =============================================================================
#  Kontener stoi ZA dwoma warstwami proxy: Cloudflare → Railway edge → tutaj.
#  Dlatego:
#    * auto_https off  — TLS terminują Cloudflare i Railway. Caddy nie może
#                        wystawić certyfikatu (nie widzi portu 443 z internetu)
#                        i próba ACME kończyłaby się pętlą błędów.
#    * nasłuch po HTTP na :{$PORT} — port wstrzykuje Railway.
#    * nagłówki X-Forwarded-* przepuszczamy do PHP; prawdziwe IP wyciąga
#      Laravel przez TrustProxies (patrz DEPLOYMENT_RUNBOOK.md).
# =============================================================================

{
	# Wyłącz automatyczne HTTPS — TLS jest wyżej w łańcuchu.
	auto_https off

	# Logi w JSON na stdout → Railway parsuje je jako structured logs.
	log {
		output stdout
		format json
		level {$CADDY_LOG_LEVEL:INFO}
	}

	# Nie ujawniaj wersji serwera.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}

	# Hook dla FrankenPHP (tryb worker włączysz przez FRANKENPHP_CONFIG).
	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$SERVER_NAME::8080} {
	root /app/public

	# -------------------------------------------------------------------------
	# Limit rozmiaru ciała żądania (audyt A5-16).
	#
	# Bez tego anonim mógł wysyłać równolegle POST-y po 112 MB na dowolną
	# trasę (np. /login). PHP buforuje ciało do /tmp, ZANIM zadziała CSRF
	# i limit zapytań w Laravelu — więc koszt ponosił serwer, nie atakujący.
	#
	# Dwa progi:
	#  * 112MiB wszędzie — tyle samo co `post_max_size=112M` w docker/php.ini
	#    (PHP liczy M jako 1024², Caddy „MB" jako 1000²);
	#    większe ciało PHP i tak odrzuci, więc nie ma po co go czytać;
	#  * 2MB poza trasami, które przyjmują zdjęcia. Najdłuższy formularz bez
	#    pliku (przepis, komentarz, „Napisz do nas") to kilkadziesiąt KB.
	#
	# Lista tras z plikami to KAŻDA trasa z `photos.*`/zdjęciem w walidacji:
	# /dodaj/* (wpis, przepis), /pytania, /przepisy/* (edycja przepisu,
	# „Ugotowałem" ze zdjęciem), /wpisy/* (edycja wpisu), /ustawienia/zdjecie,
	# Livewire (kreator przepisu; prefiks bywa `/livewire-<hash>`) i /storage/*
	# (podpisany zapis na dysk lokalny). Nowa trasa z uploadem MUSI tu trafić,
	# inaczej zdjęcia powyżej 2 MB dostaną 413.
	#
	# ZMIERZONE (FrankenPHP 1.12 / Caddy 2.11): po przekroczeniu `max_size`
	# Caddy NIE odpowiada 413 — ucina ciało po cichu i PHP dostaje 200
	# z obciętymi danymi. Dlatego odmowa idzie PO NAGŁÓWKU Content-Length
	# (przeglądarka wysyła go przy każdym formularzu): ≥ 2 000 000 bajtów poza
	# trasami z plikami → 413 bez czytania ciała. `request_body` zostaje
	# jako sufit dla ciał bez długości (chunked). „2MB" w Caddy to
	# 2 000 000 bajtów, tyle samo co próg w wyrażeniu niżej.
	# -------------------------------------------------------------------------
	@zaDuzeBezPlikow {
		not path /dodaj/* /pytania /przepisy/* /wpisy/* /ustawienia/zdjecie /livewire/* /livewire-* /storage/*
		header_regexp Content-Length ^([2-9][0-9]{6}|[1-9][0-9]{7,})$
	}
	respond @zaDuzeBezPlikow "Za duże żądanie." 413

	@bezPlikow not path /dodaj/* /pytania /przepisy/* /wpisy/* /ustawienia/zdjecie /livewire/* /livewire-* /storage/*
	request_body @bezPlikow {
		max_size 2MB
	}
	request_body {
		max_size 112MiB
	}

	# -------------------------------------------------------------------------
	# Kompresja. Cloudflare i tak kompresuje na krawędzi, ale ruch
	# Railway edge → kontener też warto ścisnąć (płacisz za egress).
	# -------------------------------------------------------------------------
	encode zstd br gzip

	# -------------------------------------------------------------------------
	# Nagłówki bezpieczeństwa.
	# HSTS ustawia Cloudflare (jedno miejsce, jedna prawda) — patrz
	# INFRA_DECISION.md, sekcja "Domena i DNS". Tutaj tylko to, czego CF nie da.
	# -------------------------------------------------------------------------
	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		# DENY, nie SAMEORIGIN. Laravel (ApplySecurityHeaders) wysyła DENY,
		# a CSP ma `frame-ancestors 'none'` — SAMEORIGIN był tu trzecią,
		# luźniejszą odpowiedzią na to samo pytanie. Kuking nigdzie nie
		# osadza sam siebie w ramce, więc SAMEORIGIN niczego nie umożliwiał;
		# dawał tylko rozjazd między warstwami. A to, która z dwóch wartości
		# faktycznie dojdzie do przeglądarki, zależy od kolejności
		# middleware'ów w Caddy, nie od Laravela — runbook wdrożeniowy
		# notował jako wartość oczekiwaną na produkcji właśnie SAMEORIGIN,
		# czyli w praktyce wygrywał ten plik. Pilnuje tego teraz
		# CaddySpojnyZNaglowkamiLaravelaTest (ustalenie W7-11).
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		# CSP celowo NIE tutaj — Livewire wstrzykuje inline skrypty i CSP
		# trzeba dopiąć z nonce w middleware Laravela, nie na poziomie serwera.
	}

	# -------------------------------------------------------------------------
	# Assety Vite: nazwy plików są hashowane (app-a1b2c3.js), więc możemy
	# cache'ować agresywnie i immutable. Cloudflare Cache Rule powinna to
	# zdublować na krawędzi (patrz INFRA_DECISION.md).
	# -------------------------------------------------------------------------
	@viteAssets path /build/assets/*
	header @viteAssets {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# Manifest NIE ma hasha w nazwie. Czyta go Laravel z dysku (`@vite`),
	# żeby wstawić do HTML-a odnośniki do plików z hashem — przeglądarka go
	# nie potrzebuje i sama nie pobiera. Poprzednia reguła `path /build/*`
	# dawała mu jednak rok `immutable`, a to obietnica „ten adres nigdy się
	# nie zmieni", której plik bez hasha nie spełnia: każdy, kto go pobierze
	# (CDN, narzędzie, człowiek), trzymałby po wdrożeniu nieaktualną treść.
	# `no-cache` nie znaczy „nie przechowuj", tylko „zapytaj, zanim użyjesz".
	@viteManifest path /build/manifest.json
	header @viteManifest Cache-Control "no-cache"

	# Statyka bez hasha (favicon, manifest PWA, ikony) — krócej.
	@staticRoot path /favicon.ico /robots.txt /manifest.webmanifest
	header @staticRoot {
		Cache-Control "public, max-age=3600"
	}

	# Worker ma własny cykl aktualizacji; CDN nie może utrwalać jego starej wersji.
	@serviceWorker path /sw.js
	header @serviceWorker {
		Cache-Control "no-store, no-cache, must-revalidate"
	}

	# -------------------------------------------------------------------------
	# Nigdy nie cache'uj odpowiedzi aplikacji ani endpointów Livewire.
	# To druga linia obrony — pierwsza to Cache Rules w Cloudflare.
	# Wyciek scache'owanej strony zalogowanego użytkownika do innego
	# użytkownika to incydent RODO, nie usterka wydajności.
	# -------------------------------------------------------------------------
	@dynamic {
		path /livewire/* /login /logout /register /konto/* /ustawienia/* /api/*
	}
	header @dynamic {
		Cache-Control "no-store, no-cache, must-revalidate, private"
		Vary "Cookie"
	}

	# -------------------------------------------------------------------------
	# Healthcheck.
	# Railway odpytuje /health z hosta healthcheck.railway.app.
	# Trasę obsługuje Laravel (sprawdza połączenie z bazą), a nie Caddy —
	# healthcheck, który zawsze zwraca 200, nie chroni przed niczym.
	# Jeśli włączysz w Laravelu middleware TrustHosts, dopisz do listy
	# 'healthcheck.railway.app', inaczej deploy będzie padał na 400.
	# Źródło: https://docs.railway.com/deployments/healthchecks
	# -------------------------------------------------------------------------

	# Zablokuj dostęp do plików, które nigdy nie powinny wyjść na świat,
	# nawet gdyby ktoś przypadkiem skopiował je do public/.
	@forbidden path /.env* /.git/* /composer.json /composer.lock /*.md
	respond @forbidden 404

	# -------------------------------------------------------------------------
	# PHP. php_server = try_files $uri $uri/ /index.php + FastCGI-równoważnik.
	# -------------------------------------------------------------------------
	php_server {
		index index.php
	}
}
