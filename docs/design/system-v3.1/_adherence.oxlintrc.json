        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:znak|tytul|opis|className|children|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: znak, tytul, opis, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BladPola'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|tekst|key|ref|className|style|children)$/]",
        "message": "<BladPola> doesn't accept that prop. Declared props: id, tekst."
