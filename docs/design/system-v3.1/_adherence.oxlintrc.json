{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/cards/**",
              "components/content/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "components/recipe/**",
              "ui_kits/dokumenty/**",
              "ui_kits/serwis/**",
              "ui_kits/strona-www/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter Variable|Inter Fallback|Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter Variable, Inter Fallback, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:odmiana|ikona|className|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: odmiana, ikona, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='odmiana'] > Literal[value!=/^(?:sukces|blad|info)$/]",
        "message": "<Alert> odmiana must be one of 'sukces' | 'blad' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:solo|naglowek|nawigacja|szyna|stopka|className|children|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: solo, naglowek, nawigacja, szyna, stopka, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:imie|href|avatarSrc|dopisek|className|key|ref|className|style|children)$/]",
        "message": "<AuthorRow> doesn't accept that prop. Declared props: imie, href, avatarSrc, dopisek, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AutosaveBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tekst|className|key|ref|className|style|children)$/]",
        "message": "<AutosaveBadge> doesn't accept that prop. Declared props: tekst, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|imie|rozmiar|alt|className|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, imie, rozmiar, alt, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='rozmiar'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Avatar> rozmiar must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:waga|ikona|className|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: waga, ikona, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='waga'] > Literal[value!=/^(?:cichy|spokojny|cooked|sukces|blad)$/]",
        "message": "<Badge> waga must be one of 'cichy' | 'spokojny' | 'cooked' | 'sukces' | 'blad'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PozycjaDolna'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|ikona|klucz|glowna|key|ref|className|style|children)$/]",
        "message": "<PozycjaDolna> doesn't accept that prop. Declared props: href, label, ikona, klucz, glowna."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:waga|duzy|pelny|href|type|disabled|ariaDisabled|wyjasnienie|ikona|className|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: waga, duzy, pelny, href, type, disabled, ariaDisabled, wyjasnienie, ikona, className, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='waga'] > Literal[value!=/^(?:primary|secondary|quiet|danger)$/]",
        "message": "<Button> waga must be one of 'primary' | 'secondary' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|children|key|ref|className|style|children)$/]",
        "message": "<ButtonRow> doesn't accept that prop. Declared props: className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|disabled|powodWylaczenia|className|children|name|checked|defaultChecked|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: id, disabled, powodWylaczenia, className, children, name, checked, defaultChecked, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|biezacy|className|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: href, biezacy, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|help|key|ref|className|style|children)$/]",
        "message": "<ChoiceOption> doesn't accept that prop. Declared props: value, label, help."
      },
      {
        "selector": "JSXOpeningElement[name.name='Komentarz'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|autor|autorHref|avatarSrc|tresc|czas|odpowiedzHref|wOdpowiedziDo|key|ref|className|style|children)$/]",
        "message": "<Komentarz> doesn't accept that prop. Declared props: id, autor, autorHref, avatarSrc, tresc, czas, odpowiedzHref, wOdpowiedziDo."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDestructive'] > JSXAttribute > JSXIdentifier[name!=/^(?:etykieta|pytanie|potwierdzenie|anuluj|action|hrefAnuluj|onPotwierdz|otwarte|children|key|ref|className|style|children)$/]",
        "message": "<ConfirmDestructive> doesn't accept that prop. Declared props: etykieta, pytanie, potwierdzenie, anuluj, action, hrefAnuluj, onPotwierdz, otwarte, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CookedCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:autor|autorHref|avatarSrc|przepis|przepisHref|forma|czas|tresc|zdjecie|alt|className|key|ref|className|style|children)$/]",
        "message": "<CookedCard> doesn't accept that prop. Declared props: autor, autorHref, avatarSrc, przepis, przepisHref, forma, czas, tresc, zdjecie, alt, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:naglowki|wiersze|wstep|className|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: naglowki, wiersze, wstep, className."
