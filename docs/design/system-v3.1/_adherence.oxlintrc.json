      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|etykieta|typ|szerokosc|wymagane|podpowiedz|help|blad|dlugie|opcje|disabled|powodWylaczenia|className|children|name|value|defaultValue|placeholder|onChange|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: id, etykieta, typ, szerokosc, wymagane, podpowiedz, help, blad, dlugie, opcje, disabled, powodWylaczenia, className, children, name, value, defaultValue, placeholder, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='typ'] > Literal[value!=/^(?:text|textarea|select|number|email|password|search|tel|url)$/]",
        "message": "<Field> typ must be one of 'text' | 'textarea' | 'select' | 'number' | 'email' | 'password' | 'search' | 'tel' | 'url'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='szerokosc'] > Literal[value!=/^(?:rok|liczba|krotkie|srednie|pelne)$/]",
