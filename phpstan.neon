# =============================================================================
#  Kuking.pl — konfiguracja Larastan/PHPStan (issue #32)
# =============================================================================
#
#  Ta sama konfiguracja jest używana lokalnie (`./scripts/check.sh`,
#  `vendor/bin/phpstan analyse`) i w CI (job `static-analysis` w
#  .github/workflows/ci.yml, krok "PHPStan": `vendor/bin/phpstan analyse
#  --no-progress --memory-limit=1G`, bez własnego `-c` — PHPStan sam
#  znajduje ten plik w katalogu głównym). Rozjazd między lokalną a CI-ową
#  konfiguracją byłby gorszy niż brak lokalnej w ogóle: ludzie przestają
#  ufać lokalnemu wynikowi, gdy CI mówi co innego tym samym poleceniem.
#
#  POZIOM: 1 (docelowo 8 — issue #32, audyt F-11)
#  ---------------------------------------------------------------------------
#  Issue #32 zakładało start od poziomu 5. Pierwsze uruchomienie dało na nim
#  158 błędów, więc zaczęliśmy od 0 — świadomie nisko, ale bez baseline'u.
#
#  Baseline z dziesiątkami wyjątków byłby GORSZY niż uczciwie niski poziom:
#  usypia, bo wygląda na „przeanalizowane", a każdy wyciszony błąd znika
#  z pola widzenia na zawsze. Ta zasada zostaje.
#
#  Poziom 1 kosztował cztery poprawki i wszystkie były realną robotą, nie
#  uciszaniem analizatora:
#
#    - `App\Models\Media` (3 błędy): `metadata` to JSONB rzutowane na tablicę,
#      więc dla analizy było tablicą o nieznanej zawartości. Kształt wariantów
#      opisywał wyłącznie komentarz w `ProcessUploadedImage`, a trzy metody
#      czytały go na trzy sposoby. Teraz jest jedna metoda `warianty()`
#      z jawnym typem zwracanym i prawdziwym `is_array()` — w bazie mogą leżeć
#      wiersze sprzed każdej zmiany tego formatu.
#
#    - `PolitykaBezpieczenstwaTest` (1 błąd): `Log::shouldHaveReceived()`
#      działa w czasie wykonania (fasada przekazuje wywołanie do obiektu
#      Mockery), ale analiza widzi samą fasadę. Szpieg trafił do zmiennej.
#
#  GDZIE STOI NASTĘPNY PRÓG (zmierzone, nie zgadnięte):
#      poziom 2 → 172 błędy      poziom 3 → 194
#      poziom 4 → 232            poziom 5 → 299
#
#  Skok z 0 na 1 był tani, z 1 na 2 nie jest. To osobna praca i należy do
#  issue #32 — nie do PR-a, który akurat przechodził obok.
#
#  IGNOROWANY BŁĄD PONIŻEJ POZIOMU (nie „baseline"):
#  `larastan.noEnvCallsOutsideOfConfig` w `tests/*` — Larastan ostrzega przed
#  wywołaniem `env()` poza katalogiem `config/`, bo w produkcji (po
#  `config:cache`) taki `env()` cicho zwraca null. W testach ten sam `env()`
#  jest CELOWY: `tests/Feature/KonfiguracjaDyskowTest.php` sprawdza właśnie
#  to, czy zmienna środowiskowa faktycznie trafia do configu — musi więc
#  odczytać obie strony niezależnie. To jeden, nazwany, uzasadniony wyjątek
#  ograniczony do `tests/`, nie baseline zamiatający błędy pod dywan.
#
#  `bootstrapFiles: phpstan-bootstrap.php` (D-021, praca nad tagami) — druga
#  połowa pułapki opisanej w `tests/bootstrap.php`, tym razem w Larastanie:
#  bez tego KAŻDY nowy model dodany w git worktree z dowiązanym `vendor/`
#  dostaje fałszywe „Access to an undefined property”, bo Larastan próbuje
#  go PRAWDZIWIE zainstancjonować przez classmap Composera, a ten wskazuje
#  na główny checkout, w którym ta klasa jeszcze nie istnieje. Uzasadnienie
#  i pomiar w komentarzu tamtego pliku. No-op w głównym katalogu i w CI.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 1

    bootstrapFiles:
        - phpstan-bootstrap.php

    paths:
        - app
        - config
        - database
        - routes
        - tests

    # Klasy narzędzi badawczych pilotów AI (`Kuking\AiPilots\{Pilot,Transport,
    # Budget}`) leżą w `scripts/ai-pilots/` i są wciągane przez `require_once`
    # w `setUp` testów kontraktowych, a nie przez autoload Composera. PHPStan
    # takiej drogi nie prześledzi i zgłaszał 21 × „unknown class".
    #
    # To NIE jest wyciszenie: `scanDirectories` mówi analizatorowi, gdzie te
    # klasy SĄ, więc sygnatury zaczynają być sprawdzane. Dotąd było odwrotnie —
    # testy meldowały „przechodzą", a zmiana nazwy metody w `Pilot` nie
    # zapaliłaby nigdzie. Kontrakt wyglądał na pokryty i pokryty nie był.
    #
    # `scanDirectories`, a nie `paths`: te skrypty nie są kodem produktu
    # i nie mają być analizowane na poziomie projektu — mają być ROZPOZNAWANE.
    # Droga przez `autoload-dev` w composer.json działałaby w CI (jest tam
    # `composer install`), ale nie u bramki pchania: runtime dostaje `vendor/`
    # kopiowany z pamięci podręcznej, bez `dump-autoload`. Sprawdzone
    # pomiarem — poprawka w composer.json nie zmieniła wyniku bramki ani o jeden
    # błąd. Jedno miejsce, działające po obu stronach, jest lepsze niż dwa.
    scanDirectories:
        - scripts/ai-pilots

    # Współdzielony z krokiem cache w CI ("Cache PHPStana", path: .phpstan-cache)
    # — bez tego CI cache'owałoby katalog, którego PHPStan nigdy by nie użył,
    # i każdy przebieg analizowałby wszystko od zera.
    tmpDir: .phpstan-cache

    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: tests/*
