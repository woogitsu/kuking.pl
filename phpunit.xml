<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Testy chodzą na PostgreSQL, nie na SQLite.

            Powód: schemat Kuking opiera się na rzeczach, których SQLite nie ma —
            indeksach częściowych, num_nonnulls(), gen_random_uuid(), pg_trgm
            i unaccent w wyszukiwarce. Test na SQLite przechodziłby, a produkcja
            i tak by się wywaliła. Baza testowa musi istnieć wcześniej — o to
            (i o bazy per-worktree) dba `.claude/hooks/session-start.sh`.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <!--
            DB_DATABASE celowo NIE jest tu ustawiane na sztywno (issue #66).

            Nazwę wylicza `tests/bootstrap.php` — "kuking_test" w głównym
            katalogu, "kuking_test_<worktree>" w każdym `git worktree` — żeby
            dwa równoległe przebiegi `php artisan test` w różnych katalogach
            nie zrzucały sobie nawzajem schematu w trakcie działania. Pełne
            uzasadnienie i alternatywy, których nie wybrano: komentarz na
            górze tests/bootstrap.php.
        -->
        <env name="DB_USERNAME" value="kuking"/>
        <env name="DB_PASSWORD" value="kuking"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="KUKING_MEDIA_DISK" value="public"/>
        <!--
            Ile wpisów w `X-Forwarded-For` dopisuje infrastruktura
            (`config/proxy.php`, ustalenie SEC-01).

            Wartość stoi TUTAJ, a nie tylko w `.env.example`, bo CI robi
            `cp .env.example .env`, a tamten plik ustawia 0 — czyli „nie ufaj
            temu nagłówkowi wcale", stan właściwy dla `php artisan serve` bez
            proxy. Testy SEC-01 podstawiają nagłówek i sprawdzają, KTÓRY wpis
            aplikacja z niego weźmie; przy zerze nie wzięłaby żadnego i cały
            `PodrobionyNaglowekProxyTest` zrobiłby się zielony na 127.0.0.1,
            nie sprawdzając niczego. `<env>` bez `force` nie nadpisuje zmiennej
            z otoczenia, ale bije `.env` — Dotenv Laravela jest niemutowalny.
        -->
        <env name="KUKING_ZAUFANE_PRZESKOKI" value="1"/>
    </php>
</phpunit>
