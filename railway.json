{
  "$schema": "https://railway.com/railway.schema.json",

  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",

    "watchPatterns": [
      "app/**",
      "bootstrap/**",
      "config/**",
      "database/**",
      "public/**",
      "resources/**",
      "routes/**",
      "docker/**",
      "Dockerfile",
      "composer.json",
      "composer.lock",
      "package.json",
      "package-lock.json",
      "vite.config.js",
      "artisan"
    ]
  },

  "deploy": {
    "startCommand": "/usr/local/bin/kuking-entrypoint web",
    "preDeployCommand": ["php artisan migrate --force --no-interaction"],
    "preDeployTimeoutSeconds": 600,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 180,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
