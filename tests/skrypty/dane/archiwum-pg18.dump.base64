# Kuking.pl — PRAWDZIWE archiwum `pg_dump --format=custom`, w base64.
#
# PO CO TO JEST: regresja z `tests/skrypty/kopia-bazy.sh` na usterkę z 18.09.2026
# („pg_restore --list przepuszcza archiwum obcięte"). Tamten test potrzebuje
# PRAWDZIWEGO archiwum, bo mierzy zachowanie PRAWDZIWEGO `pg_restore` — atrapa
# `pg_restore` udowodniłaby wyłącznie, że test umie podstawić funkcję.
# Plik jest tu, a nie w kodzie testu, żeby test dało się przeczytać.
#
# JAK GO ODTWORZYĆ (dowolny PostgreSQL 18, dowolna baza jednorazowa):
#   createdb fikstura
#   psql fikstura -c "CREATE TABLE przepisy (id int primary key, tytul text);
#                     INSERT INTO przepisy
#                     SELECT g, md5(g::text) || md5((g*7)::text)
#                     FROM generate_series(1,80) g;"
#   pg_dump fikstura --format=custom --no-owner --no-privileges --file=a.dump
#   base64 -w 76 a.dump
#
# CO W NIM JEST: jedna tabela, 80 wierszy sumy MD5 z generate_series. Żadnych
# danych osobowych, żadnego schematu Kukinga — to ma być archiwum, nie zrzut.
# Linie zaczynające się od „#" pomija czytający je test.
